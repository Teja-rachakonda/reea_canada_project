PORT=3001

# Required for REAAMusic. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Find Businesses source: 'osm' = free OpenStreetMap (no card/key, works out of the box),
# 'google' = Google Places (better coverage, needs the key below + billing enabled).
BUSINESS_PROVIDER=osm
# Only used when BUSINESS_PROVIDER=google. Enable "Places API (New)" + billing on the key.
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_PLACES_KEY=

# Optional — without these, songs still generate but save to the browser only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Phase 2. HeyGen powers Video Studio. Needs a plan with API credits (separate
# from the UI credits used to build avatars). HEYGEN_TEMPLATE_ID is the HeyGen
# template whose script_text variable gets the generated script.
HEYGEN_API_KEY=
HEYGEN_TEMPLATE_ID=
ELEVENLABS_API_KEY=
VAPI_API_KEY=
FLAAXA_API_KEY=
META_ACCESS_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_MAPS_KEY=

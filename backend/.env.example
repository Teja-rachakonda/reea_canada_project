PORT=3001

# Required for REAAMusic. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Find Businesses source: 'osm' = free OpenStreetMap (no card/key, works out of the box),
# 'google' = Google Places (better coverage, needs the key below + billing enabled).
BUSINESS_PROVIDER=osm
# Only used when BUSINESS_PROVIDER=google. Enable "Places API (New)" + billing on the key.
# https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_PLACES_KEY=

# Optional — without these, songs still generate but save to the browser only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Phase 2 — not wired up yet.
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
VAPI_API_KEY=
FLAAXA_API_KEY=
META_ACCESS_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_MAPS_KEY=
